{
  "name": "kontenplan",
  "productName": "KontenPlan",
  "version": "1.0.0",
  "description": "Perencana konten video & poster untuk tim, dengan asisten AI",
  "main": "main.js",
  "author": "KontenPlan Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kontenplan.app",
    "publish": null,
    "productName": "KontenPlan",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "KontenPlan-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KontenPlan"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "KontenPlan-${version}.dmg",
      "identity": null
    },
    "dmg": {
      "title": "KontenPlan"
    }
  }
}
